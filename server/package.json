{
  "name": "potko-server",
  "version": "2.0.2",
  "private": true,
  "description": "POTKO API and live events (Express + ws)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "db:local": "node src/scripts/local-db.js",
    "db:schema": "node src/scripts/db.js schema",
    "db:setup": "node src/scripts/db.js setup",
    "db:migrate": "node src/scripts/db.js migrate",
    "db:reset": "node src/scripts/db.js reset",
    "db:clear": "node src/scripts/db.js clear",
    "restaurant:add": "node src/scripts/add-restaurant.js",
    "demo:snapshot": "node src/demo-snapshot.js",
    "demo": "node --expose-gc src/demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
