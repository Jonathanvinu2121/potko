# Neon connection string (Neon dashboard -> Connect). Keep "?sslmode=require" on the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# No Neon yet? Run "npm run db:local" in another terminal and use this instead:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Any long random text. Signs the login tokens; changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-value

# Render sets PORT itself; 4000 is used on your own machine.
PORT=4000
