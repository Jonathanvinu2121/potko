# Where the POTKO server runs. The live connection uses the same address.
# On your own machine: http://localhost:4000
# On a phone, "localhost" is the phone itself: use your laptop's Wi-Fi address
# (for example http://192.168.1.20:4000) or the Render address.
# The address can also be changed inside the app, from the first screen.
EXPO_PUBLIC_API_URL=http://localhost:4000
